<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-djaus2" value="https://nuget.pkg.github.com/djaus2/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github-djaus2">
      <package pattern="GameVoice" />
    </packageSource>
  </packageSourceMapping>
  <!-- GitHub Packages needs a token with read:packages; see docs/game-voice-library.md. Never commit the token. -->
</configuration>
