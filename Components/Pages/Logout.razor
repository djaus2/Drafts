@page "/logout"
@inject Draughts.Services.DbAuthenticationStateProvider DbAuthStateProvider
@inject NavigationManager Nav

<p>Signing out...</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await DbAuthStateProvider.SignOutAsync();
        }
        catch
        {
        }

        Nav.NavigateTo("/login", forceLoad: false);
    }
}
